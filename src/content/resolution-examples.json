  "files": {
    "01-imports-and-math.scss": [
      "@use \"./scss/components\" as controls;",
      "",
      ".button {",
      "  background: controls.$button-background;",
      "  padding: controls.$button-padding;",
      "  border-radius: controls.$button-radius;",
      "  font-size: controls.$button-font-size;",
      "}"
    ],
    "02-css-values.css": [
      "@import \"./css/tokens.css\";",
      "",
      ".panel {",
      "  padding: var(--panel-inset);",
      "  border: var(--panel-border);",
      "  background: var(--panel-accent);",
      "  font-size: var(--panel-font);",
      "  width: var(--panel-width);",
      "}"
    ],
    "03-less-imports.less": [
      "@import \"./less/components.less\";",
      "",
      ".tile {",
      "  padding: @tile-padding;",
      "  background: @tile-background;",
      "}"
    ],
    "04-sass-aliases.sass": [
      "@use \"./sass/tokens\" as *",
      "",
      ".notice",
      "  background: $notice-fill",
      "  padding: $notice-inset"
    ],
    "css/foundation.css": [
      ":root {",
      "  --scale-step: 8px;",
      "  --foundation-iris: #B8A4F4;",
      "  --foundation-font: 1.125rem;",
      "}"
    ],
    "css/tokens.css": [
      "@import \"./foundation.css\";",
      "",
      ":root {",
      "  --action-iris: var(--foundation-iris);",
      "  --panel-inset: calc(var(--scale-step) * 3);",
      "  --panel-border: 1px solid var(--action-iris);",
      "  --panel-accent: var(--optional-accent, var(--action-iris));",
      "  --panel-font: var(--foundation-font);",
      "  --panel-width: clamp(16rem, calc(100vw - var(--scale-step)), 48rem);",
      "}"
    ],
    "less/components.less": [
      "@import \"./semantic.less\";",
      "",
      "@tile-padding: (@space-roomy / 2);",
      "@tile-background: @surface-warm;"
    ],
    "less/foundation.less": ["@space-seed: 6px;", "@palette-peach: #E9AC95;"],
    "less/semantic.less": [
      "@import \"./foundation.less\";",
      "",
      "@space-roomy: (@space-seed * 4);",
      "@surface-warm: @palette-peach;"
    ],
    "sass/_foundation.sass": ["$palette-mint: #A8C9AF", "$space-tick: 0.5rem"],
    "sass/_tokens.sass": [
      "@use \"./foundation\" as *",
      "",
      "$notice-fill: $palette-mint",
      "$notice-inset: ($space-tick * 3)"
    ],
    "scss/_components.scss": [
      "@use \"./semantic\" as *;",
      "",
      "$button-background: $action-color;",
      "$button-padding: ($space-medium * 2);",
      "$button-radius: $radius-control;",
      "$button-font-size: $type-label;"
    ],
    "scss/_primitives.scss": [
      "$palette-iris: #B8A4F4;",
      "$space-unit: 4px;",
      "$radius-base: 6px;",
      "$type-base: 1rem;"
    ],
    "scss/_semantic.scss": [
      "@use \"./primitives\" as *;",
      "",
      "$action-color: $palette-iris;",
      "$space-medium: ($space-unit * 3);",
      "$radius-control: ($radius-base + 2);",
      "$type-label: ($type-base * 0.875);"
    ]
  }
}
